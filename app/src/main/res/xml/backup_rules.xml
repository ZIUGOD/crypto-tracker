<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 30 and lower. The session (account, privacy consent) is tied to the
   device and must not be restored elsewhere; pinned coins and theme are safe to back up.
-->
<full-backup-content>
    <include domain="sharedpref" path="."/>
    <exclude domain="sharedpref" path="session_prefs.xml"/>
    <exclude domain="sharedpref" path="coin_cache_prefs.xml"/>
</full-backup-content>
