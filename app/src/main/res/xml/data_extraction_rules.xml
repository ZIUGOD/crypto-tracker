<?xml version="1.0" encoding="utf-8"?>
<!--
   Backup rules for API 31+. The session (account, privacy consent) is tied to the device and
   must not be restored elsewhere; pinned coins and theme are safe to back up.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="session_prefs.xml"/>
        <exclude domain="sharedpref" path="coin_cache_prefs.xml"/>
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="."/>
        <exclude domain="sharedpref" path="session_prefs.xml"/>
        <exclude domain="sharedpref" path="coin_cache_prefs.xml"/>
    </device-transfer>
</data-extraction-rules>
